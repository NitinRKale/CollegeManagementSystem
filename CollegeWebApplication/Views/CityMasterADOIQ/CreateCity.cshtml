@model CollegeWebApplication.Models.CityMaster

@{
    ViewData["Title"] = "CreateCity";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="card card-success">
    <div class="card-header">
        <h3 class="card-title">Add New Student</h3>

        <div class="card-tools">
            <button type="button" class="btn btn-tool" data-card-widget="collapse">
                <i class="fas fa-minus"></i>
            </button>
            <button type="button" class="btn btn-tool" data-card-widget="remove">
                <i class="fas fa-times"></i>
            </button>
        </div>
    </div>
    <!-- /.card-header -->
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="row">
                <!-- /.col -->
                <div class="col-md-6">

                    <div class="form-group">
                        <label asp-for="CityName" class="control-label"></label>
                        <input asp-for="CityName" class="form-control" />
                        <span asp-validation-for="CityName" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="StateId" class="control-label"></label>
                        <select asp-for="StateId" class="form-control">
                            <option value="">--Select State---</option>
                            @foreach (var item in ViewBag.States)
                            {
                                <option value="@item.StateId">@item.StateName</option>
                            }
                        </select>
                        <span asp-validation-for="StateId" class="text-danger"></span>
                    </div>

                    <br />
                    <div class="form-group">
                        <input type="submit" value="Create" class="btn btn-primary" />
                        <a asp-action="Index" class="btn btn-info">Back to List</a>
                    </div>
                </div>
                <!-- /.col -->
            </div>
        </form>
        <!-- /.row -->
    </div>
</div>


